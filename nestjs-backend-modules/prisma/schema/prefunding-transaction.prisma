enum PrefundingTransactionType {
  TRANSFER_DEPOSIT
  TRANSFER_PAYOUT
  INTERNAL_TOP_UP
  INTERNAL_WITHDRAW
  ADJUSTMENT

  @@map("prefunding_transaction_type")
}

enum PrefundingDirection {
  IN
  OUT

  @@map("prefunding_direction")
}

model PrefundingTransaction {
  id                    String                    @id @default(uuid()) @db.Uuid
  originalTransactionId String?                   @map("original_transaction_id") @db.Uuid
  type                  PrefundingTransactionType
  direction             PrefundingDirection
  amount                Decimal                   @db.Decimal(20, 2)
  currency              String                    @db.Char(3)
  bankAccountId         String                    @map("bank_account_id") @db.Uuid
  metadata              Json?                     @default("{}")
  createdAt             DateTime                  @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @map("created_at") @db.Timestamptz(3)

  originalTransaction Transaction?           @relation(fields: [originalTransactionId], references: [id])
  bankAccount         PrefundingBankAccount  @relation(fields: [bankAccountId], references: [id])
  logs                PrefundingAccountLog[]

  @@index([originalTransactionId])
  @@index([bankAccountId, createdAt(sort: Desc)])
  @@map("prefunding_transactions")
}
