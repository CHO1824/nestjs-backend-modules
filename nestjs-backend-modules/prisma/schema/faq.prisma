model Faq {
  id        String   @id @default(uuid()) @db.Uuid
  question  String   @db.VarChar(255)
  answer    String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive], map: "idx_faqs_is_active")
  @@index([sortOrder], map: "idx_faqs_sort_order")
  @@index([createdAt], map: "idx_faqs_created_at")
  @@map("faqs")
}
