// ------------------------------------------------------
// 1. Event-Driven Notification Models & Dashboard Tracking
// ------------------------------------------------------

enum NotificationEventType {
  KYC_STATUS_CHANGED
  TRANSACTION_STATUS_CHANGED
}

enum NotificationEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum NotificationChannel {
  EMAIL
  PUSH
  SMS
  KAKAO
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model NotificationEvent {
  id        String                  @id @default(uuid()) @db.Uuid
  userId    String                  @map("user_id") @db.Uuid
  type      String                  @map("event_type")
  payload   Json                    @map("payload")
  status    NotificationEventStatus @default(PENDING) @map("status")
  createdAt DateTime                @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("notification_events")
}

model NotificationDelivery {
  id      String              @id @default(uuid()) @db.Uuid
  eventId String              @map("event_id") @db.Uuid
  channel NotificationChannel @map("channel")

  provider   String?  @map("provider") // e.g., "ALIGO", "TWILIO", "AWS_SNS"
  externalId String?  @unique @map("external_id") // Vendor's message ID for webhook tracking
  cost       Decimal? @default(0) @map("cost") @db.Decimal(10, 2) // Cost per message for analytics

  recipient     String                     @map("recipient")
  templateCode  String                     @map("template_code")
  renderedTitle String?                    @map("rendered_title")
  renderedBody  String                     @map("rendered_body")
  status        NotificationDeliveryStatus @default(PENDING) @map("status")
  failureReason String?                    @map("failure_reason")
  sentAt        DateTime?                  @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime                   @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  event NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([channel, status])
  @@map("notification_deliveries")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @map("type") // e.g., 'TX_SUCCESS'
  title     String   @map("title")
  message   String   @map("message")
  priority  String   @map("priority")
  status    String   @default("PENDING") @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  linkId    String?  @map("link_id") // Deep link or URL to redirect on click
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("notifications")
}

// ------------------------------------------------------
// 2. High-Performance Outbox Pattern (For background delivery workers)
// ------------------------------------------------------
model NotificationOutbox {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  traceId String? @map("trace_id") @db.Uuid // For logging and tracing

  // Business policy and target information
  category    String    @db.VarChar(20) // 'TRANSACTIONAL' | 'MARKETING'
  targetValue String    @map("target_value") // Actual token, phone number, or email to be used
  locale      String    @default("en") @db.VarChar(10)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(3) // Actual successful delivery time

  channel    String @db.VarChar(20) // 'PUSH' | 'EMAIL' | 'SMS' | 'KAKAO'
  templateId String @map("template_id") @db.VarChar(50)
  payload    Json // Data required for template rendering (e.g., amount, currency)

  // Worker state management
  status      String    @default("PENDING") @db.VarChar(20) // 'PENDING' | 'PROCESSING' | 'COMPLETED' | 'FAILED'
  priority    Int       @default(0) @db.SmallInt
  retryCount  Int       @default(0) @map("retry_count")
  nextRetryAt DateTime  @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @map("next_retry_at") @db.Timestamptz(3)
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3) // Lock time to prevent duplicate processing
  errorLog    String?   @map("error_log") @db.Text
  createdAt   DateTime  @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt, priority])
  @@index([userId, status])
  @@map("notification_outbox")
}

// Editable copy for EMAIL / PUSH / SMS / in-app (one row per eventType+locale).
// Overrides the code defaults at render time so wording changes need no deploy.
// Alimtalk (KAKAO) is excluded (must match the NCP console template).
model NotificationMessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  eventType String   @map("event_type") @db.VarChar(100)
  locale    String   @db.VarChar(10)
  title     String   @map("title")
  message   String   @map("message") @db.Text
  updatedBy String?  @map("updated_by") @db.Uuid // last editor (null for seeded rows)
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([eventType, locale])
  @@map("notification_message_templates")
}

// Dedup gate for publish(): a caller-supplied key is reserved here; the UNIQUE
// constraint blocks a duplicate publish. Mirrors FX QuoteConfirmIdempotency.
model NotificationIdempotency {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  requestHash    String   @map("request_hash")
  createdAt      DateTime @default(dbgenerated("CURRENT_TIMESTAMP(3)")) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("notification_idempotency")
}
